# Neon Postgres connection string (Neon dashboard -> Connect)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments. "mock" is a Stripe-shaped test provider (no account, no real money);
# it refuses to run in production.
PAYMENT_PROVIDER="mock"
# Signs payment webhooks (32+ random characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-string"
